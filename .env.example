# Phase 1 starts without Twitch credentials. Copy to .env when configuring Twitch.
# Interface to listen on. Keep loopback for local-only access.
HOST=127.0.0.1
# HTTP port.
PORT=3000
# Application origin; must match Twitch's registered callback origin.
BASE_URL=http://localhost:3000
# Storage directory, resolved relative to the project root.
DATA_DIR=data
# Logging verbosity: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info
# Optional dashboard key, at least 32 characters. Generated in data/keys.json if blank.
ADMIN_KEY=
# Optional OBS key, at least 32 characters and different from ADMIN_KEY. Generated if blank.
OVERLAY_KEY=
# Twitch application Client ID. Phase 2 needs both this and TWITCH_CLIENT_SECRET.
TWITCH_CLIENT_ID=
# Twitch application secret. Never share or commit this value.
TWITCH_CLIENT_SECRET=
# Registered OAuth callback URL for Phase 2.
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# Delay after going live before opening a previously ready capsule (Phase 5).
OFFLINE_OPEN_DELAY_SECONDS=60
